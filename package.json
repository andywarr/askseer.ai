{
  "name": "askseer-workspace",
  "version": "1.2.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A run build",
    "build:prod": "yarn workspaces foreach -A run build:prod",
    "dev:ai": "yarn workspace ai-worker run dev",
    "dev:db": "yarn workspace db-worker run dev",
    "dev:web": "yarn workspace askseer.ai run dev",
    "start:ai": "yarn workspace ai-worker run start",
    "start:db": "yarn workspace db-worker run start",
    "start:web": "yarn workspace askseer.ai run start",
    "clean": "yarn workspaces foreach -A run clean",
    "type-check": "yarn workspaces foreach -A run type-check",
    "test": "yarn workspaces foreach -A run test",
    "test:ai": "yarn workspace ai-worker run test",
    "test:db": "yarn workspace db-worker run test",
    "test:web": "yarn workspace askseer.ai run test"
  },
  "packageManager": "yarn@4.5.3",
  "devDependencies": {
    "@testing-library/dom": "^10.4.1"
  }
}
