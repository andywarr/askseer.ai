generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String           @id @default(cuid())
  name      String
  logoKey       String?
  logoUpdatedAt DateTime?
  status    ApprovalStatus    @default(PENDING) // Approval state for initial company creation
  autoEnroll Boolean @default(false)
  disablePersonalTeams Boolean @default(true)
  createdByUserId String
  reviewedByUserId String?
  reviewedAt DateTime?
  domains   CompanyDomain[]
  teams     Team[]
  memberships CompanyMembership[]
  invites   CompanyInvite[]
  heuristicFamilies HeuristicFamily[]
  heuristicVisibility CompanyHeuristicVisibility[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  createdByUser User @relation("CompanyCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  reviewedByUser User? @relation("CompanyReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([status])
  @@index([createdByUserId])
  @@index([reviewedByUserId])
}

model CompanyDomain {
  id        String   @id @default(cuid())
  companyId String
  domain    String   @unique  // e.g. "dropbox.com"
  status    ApprovalStatus @default(PENDING) // Approval state for this domain
  requestedByUserId String
  reviewedByUserId  String?
  reviewedAt DateTime?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedByUser User @relation("CompanyDomainRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  reviewedByUser  User? @relation("CompanyDomainReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([status])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
}

model CompanyMembership {
  id         String      @id @default(cuid())
  companyId  String
  userId     String
  role       CompanyRole @default(MEMBER)
  canCreatePersonas Boolean @default(true)
  status     CompanyMembershipStatus @default(ACTIVE)
  joinedAt   DateTime    @default(now())
  deactivatedAt DateTime?
  invitedById String?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User        @relation("CompanyMembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy  User?       @relation("CompanyMembershipInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId])
  @@index([invitedById])
}

model CompanyInvite {
  id           String       @id @default(cuid())
  companyId    String
  email        String
  role         CompanyRole  @default(MEMBER)
  token        String       @unique
  expiresAt    DateTime
  status       InviteStatus @default(PENDING)
  invitedById  String
  teamIds      String[]     @default([])

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("CompanyInviteInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([companyId, email])
}

model Team {
  id              String            @id @default(cuid())
  name            String
  description     String?
  isPersonal      Boolean           @default(false) // true for each user's private team
  companyId       String?
  createdByUserId String
  credits         Int               @default(0)
  joinPolicy      TeamJoinPolicy    @default(REQUEST_TO_JOIN)
  isDefaultForCompany Boolean       @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Auto-refill settings
  autoRefillEnabled       Boolean   @default(false)
  autoRefillThreshold     Int?      // Trigger refill when credits fall at or below this
  autoRefillAmount        Int?      // Number of credits to purchase on auto-refill
  stripeCustomerId        String?   // Stripe Customer ID for this team
  stripePaymentMethodId   String?   // Saved payment method for auto-refill charges
  paymentMethodLast4      String?   // Last 4 digits for display (e.g., "4242")
  paymentMethodBrand      String?   // Card brand for display (e.g., "visa")
  autoRefillUpdatedAt     DateTime? // When auto-refill settings were last modified
  autoRefillUpdatedById   String?   // User who last modified auto-refill settings

  // relations
  company         Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdByUser   User              @relation("createdByUserId", fields: [createdByUserId], references: [id], onDelete: Cascade)
  autoRefillUpdatedBy User?         @relation("TeamAutoRefillUpdatedBy", fields: [autoRefillUpdatedById], references: [id], onDelete: SetNull)
  memberships     TeamMembership[]
  studies         Study[]
  invites         TeamInvite[]
  selectedByUsers User[]            @relation("SelectedTeamToUser")
  creditTransactions CreditLedger[]

  @@index([companyId])
  @@index([createdByUserId])
  @@index([isPersonal])
}

model TeamMembership {
  id          String                 @id @default(cuid())
  teamId      String
  userId      String
  role        TeamRole               @default(MEMBER)
  status      TeamMembershipStatus   @default(ACTIVE)
  joinedAt    DateTime               @default(now())
  requestNote String?                // Optional note when requesting to join

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
  @@index([status])
}

model TeamInvite {
  id           String       @id @default(cuid())
  teamId       String
  email        String
  role         TeamRole     @default(MEMBER)
  token        String       @unique
  expiresAt    DateTime
  status       InviteStatus @default(PENDING)
  invitedById  String

  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([teamId, email])
}

// Ledger of all team credit changes for auditability
model CreditLedger {
  id        String   @id @default(cuid())
  teamId    String
  studyId   String?
  byUserId  String?
  delta     Int
  reason    String?
  createdAt DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  study     Study?   @relation(fields: [studyId], references: [id], onDelete: SetNull)
  byUser    User?    @relation(fields: [byUserId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([studyId])
  @@index([byUserId])
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String          @unique
  emailVerified  DateTime?
  image          String?
  imageKey       String?
  imageUpdatedAt DateTime?
  status         UserStatus      @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  sessions       Session[]
  createdStudies Study[]         @relation("UserCreatedStudies")
  modifiedStudies Study[]        @relation("UserModifiedStudies")
  communicationPreferences CommunicationPreferences?

  teamMemberships TeamMembership[]
  teamsCreated    Team[]         @relation("createdByUserId")
  teamInvites     TeamInvite[]
  selectedTeamId String?
  selectedTeam   Team?    @relation("SelectedTeamToUser", fields: [selectedTeamId], references: [id])
  creditTransactions CreditLedger[]

  companyMemberships CompanyMembership[] @relation("CompanyMembershipUser")
  companyMembershipsInvited CompanyMembership[] @relation("CompanyMembershipInvitedBy")
  companyInvites     CompanyInvite[] @relation("CompanyInviteInvitedBy")
  companiesCreated   Company[]       @relation("CompanyCreatedBy")
  companiesReviewed  Company[]       @relation("CompanyReviewedBy")
  companyDomainsRequested CompanyDomain[] @relation("CompanyDomainRequestedBy")
  companyDomainsReviewed  CompanyDomain[] @relation("CompanyDomainReviewedBy")
  
  heuristicFamiliesCreated HeuristicFamily[] @relation("HeuristicFamilyCreatedBy")
  heuristicsCreated        Heuristic[]       @relation("HeuristicCreatedBy")
  heuristicExamplesCreated HeuristicExample[] @relation("HeuristicExampleCreatedBy")
  
  cwIssuesCreated          CWIssue[]         @relation("CWIssueCreatedBy")
  cwIssuesModified         CWIssue[]         @relation("CWIssueModifiedBy")
  cwRecommendationsCreated CWRecommendation[] @relation("CWRecommendationCreatedBy")
  cwRecommendationsModified CWRecommendation[] @relation("CWRecommendationModifiedBy")
  heResultsCreated         HEResult[]        @relation("HEResultCreatedBy")
  heResultsModified        HEResult[]        @relation("HEResultModifiedBy")
  heRecommendationsCreated HERecommendation[] @relation("HERecommendationCreatedBy")
  heRecommendationsModified HERecommendation[] @relation("HERecommendationModifiedBy")
  starredStudies           StarredStudy[]
  teamsAutoRefillUpdated   Team[]             @relation("TeamAutoRefillUpdatedBy")
  notifications            Notification[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model StarredStudy {
  id        String   @id @default(cuid())
  userId    String
  studyId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  study     Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@unique([userId, studyId])
  @@index([userId])
  @@index([studyId])
}

model Study {
  id                   String          @id @default(cuid())
  teamId               String
  createdByUserId      String
  lastModifiedByUserId String?
  name                 String?
  type                 StudyType
  status               StudyStatus     @default(PENDING)
  visibility           StudyVisibility @default(TEAM)
  shareToken           String?         @unique  // Token for public link sharing
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  files                File[]
  attempts             Int             @default(1)
  cognitiveWalkthrough CognitiveWalkthrough?
  heuristicEvaluation  HeuristicEvaluation?
  persona              Persona?
  jobData              Json?

  // relations
  team                 Team?       @relation(fields: [teamId], references: [id])
  createdByUser        User?       @relation("UserCreatedStudies", fields: [createdByUserId], references: [id])
  lastModifiedByUser   User?       @relation("UserModifiedStudies", fields: [lastModifiedByUserId], references: [id])
  creditTransactions   CreditLedger[]
  starredBy            StarredStudy[]

  @@index([teamId])
  @@index([createdByUserId])
  @@index([lastModifiedByUserId])
}

model File {
  id        String    @id @default(cuid())
  studyId   String
  bucket    String
  key       String
  originalName String?
  size      Int?
  fileType  FileType?
  imageType ImageType?
  createdAt DateTime  @default(now())
  study     Study     @relation(fields: [studyId], references: [id], onDelete: Cascade)
  heResults HEResult[]

  // Optional back-relations to Persona image links
  personaPhoto Persona? @relation("PersonaPhoto")
  personaCover Persona? @relation("PersonaCover")

  // Optional Figma frame metadata (populated when file is imported from Figma)
  figmaFileKey   String?  // Figma file key extracted from the URL
  figmaNodeId    String?  // Figma node ID for the frame
  figmaFrameName String?  // Original frame name in Figma
  figmaUrl       String?  // Original Figma URL used for import

  @@index([studyId])
  @@index([figmaFileKey])
}

model CognitiveWalkthrough {
  id      String        @id @default(cuid())
  studyId String        @unique
  goal    String
  user    String?
  context String?
  steps   CWStep[]
  study   Study         @relation(fields: [studyId], references: [id], onDelete: Cascade)
  // Optional link to the selected Persona version (links to the specific version used when creating the walkthrough)
  personaId String?
  persona   Persona? @relation(fields: [personaId], references: [id], onDelete: SetNull)

  @@index([studyId])
  @@index([personaId])
}

model CWStep {
  id                  String              @id @default(cuid())
  cognitiveWalkthroughId            String
  step                Int
  expected     Boolean
  results           CWResult[]  
  issues              CWIssue[]
  cognitiveWalkthrough              CognitiveWalkthrough            @relation(fields: [cognitiveWalkthroughId], references: [id], onDelete: Cascade)

  @@index([id])
  @@index([cognitiveWalkthroughId])
}

model CWResult {
  id                  String              @id @default(cuid())
  questionId          String
  stepId              String 
  answer              String
  source              SourceType
  question            CWQuestion       @relation(fields: [questionId], references: [id])
  step                CWStep           @relation(fields: [stepId], references: [id], onDelete: Cascade)        

  @@index([stepId])
}

model CWQuestion {
  id                  String              @id @default(cuid())
  version             Int
  questionNumber      Int
  question            String
  result              CWResult[]
}

model CWIssue {
  id                  String              @id @default(cuid())
  stepId              String
  issueType           CWIssueType?
  issue               String?
  severity            Int?                // 0-4 severity rating (0=not a problem, 4=catastrophe)
  rating              ContentRating?
  source              SourceType
  createdByUserId     String?
  lastModifiedByUserId String?
  recommendations     CWRecommendation[]
  step                CWStep           @relation(fields: [stepId], references: [id], onDelete: Cascade)
  createdByUser       User?            @relation("CWIssueCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lastModifiedByUser  User?            @relation("CWIssueModifiedBy", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([stepId])
  @@index([createdByUserId])
  @@index([lastModifiedByUserId])
}

model CWRecommendation {
  id             String   @id @default(cuid())
  issueId        String
  recommendation String
  rating         ContentRating?
  source         SourceType
  createdByUserId     String?
  lastModifiedByUserId String?
  issue          CWIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  createdByUser       User?   @relation("CWRecommendationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lastModifiedByUser  User?   @relation("CWRecommendationModifiedBy", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([issueId])
  @@index([createdByUserId])
  @@index([lastModifiedByUserId])
}

model HeuristicEvaluation {
  id                  String           @id @default(cuid())
  studyId             String           @unique
  goal                String
  user                String?
  context             String?
  heuristicFamilyId   String
  heuristicFamily     HeuristicFamily  @relation(fields: [heuristicFamilyId], references: [id], onDelete: Restrict)
  // Optional link to the selected Persona version (links to the specific version used when creating the evaluation)
  personaId           String?
  persona             Persona?         @relation(fields: [personaId], references: [id], onDelete: SetNull)
  results             HEResult[]
  study               Study            @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId])
  @@index([personaId])
  @@index([heuristicFamilyId])
}

// HeuristicFamily represents a collection of related heuristics (e.g., Nielsen, Tenets, or custom company sets)
model HeuristicFamily {
  id          String   @id @default(cuid())
  name        String   // e.g., "Nielsen's 10 Usability Heuristics", "Tenets & Traps", "Acme Corp Custom Rules"
  key         String   @unique // e.g., "NIELSEN", "TENETS", "CUSTOM_ACME_123"
  description String?
  
  // If companyId is null, this is a global/system family available to all
  // If companyId is set, this is a custom family created by that company
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // Track who created this family (null for system/global families)
  createdById String?
  createdBy   User?    @relation("HeuristicFamilyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  
  // Visibility controls for each company - allows companies to hide global families
  hiddenByCompanies CompanyHeuristicVisibility[]
  
  heuristics  Heuristic[]
  heuristicEvaluations HeuristicEvaluation[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([companyId])
  @@index([key])
  @@index([createdById])
}

// Junction table for companies that have hidden a specific global heuristic family
model CompanyHeuristicVisibility {
  id                  String           @id @default(cuid())
  companyId           String
  heuristicFamilyId   String
  isHidden            Boolean          @default(false)
  
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  heuristicFamily     HeuristicFamily  @relation(fields: [heuristicFamilyId], references: [id], onDelete: Cascade)
  
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  
  @@unique([companyId, heuristicFamilyId])
  @@index([companyId])
  @@index([heuristicFamilyId])
}

model Heuristic {
  id                String              @id @default(cuid())
  
  heuristicFamilyId String
  family            HeuristicFamily     @relation(fields: [heuristicFamilyId], references: [id], onDelete: Cascade)
  
  // Common fields
  category          String?             // Optional grouping within the family
  label             String?             // Short label
  heuristic         String              // The actual heuristic text
  
  // Track who created this heuristic (null for system/global heuristics)
  createdById       String?
  createdBy         User?               @relation("HeuristicCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  
  // Examples of when this heuristic is violated
  examples          HeuristicExample[]
  
  results           HEResult[]
  
  createdAt         DateTime            @default(now())
  updatedAt         DateTime?           @updatedAt
  
  @@index([heuristicFamilyId])
  @@index([createdById])
}

model HeuristicExample {
  id           String    @id @default(cuid())
  heuristicId  String
  title        String?   // Optional title for the example
  example      String    // Description of the violation example
  
  // Track who created this example
  createdById  String?
  createdBy    User?     @relation("HeuristicExampleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  
  heuristic    Heuristic @relation(fields: [heuristicId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  @@index([heuristicId])
  @@index([createdById])
}

model HEResult {
  id                    String              @id @default(cuid())
  heuristicId           String
  heuristicEvaluationId String
  fileId                String?
  violated              Boolean
  reason                String
  severity              Int?                // 0-4 severity rating (0=not a problem, 4=catastrophe)
  rating                ContentRating?
  source                SourceType
  createdByUserId       String?
  lastModifiedByUserId  String?
  recommendations       HERecommendation[]
  heuristicEvaluation   HeuristicEvaluation @relation(fields: [heuristicEvaluationId], references: [id], onDelete: Cascade)
  heuristic             Heuristic           @relation(fields: [heuristicId], references: [id])
  file                  File?               @relation(fields: [fileId], references: [id]) 
  createdByUser         User?               @relation("HEResultCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lastModifiedByUser    User?               @relation("HEResultModifiedBy", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)
  step                  Int?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([heuristicId])
  @@index([heuristicEvaluationId])
  @@index([fileId])
  @@index([createdByUserId])
  @@index([lastModifiedByUserId])
}

model HERecommendation {
  id             String   @id @default(cuid())
  resultId       String
  recommendation String
  rating         ContentRating?
  source         SourceType
  createdByUserId     String?
  lastModifiedByUserId String?
  result         HEResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  createdByUser       User?    @relation("HERecommendationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lastModifiedByUser  User?    @relation("HERecommendationModifiedBy", fields: [lastModifiedByUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([resultId])
  @@index([createdByUserId])
  @@index([lastModifiedByUserId])
}

model Persona {
  id           String  @id @default(cuid())
  studyId      String  @unique

  // Versioning fields
  personaGroupId String  // Groups all versions of this persona together
  version        Int     @default(1) // Version number (1, 2, 3, etc.)
  isLatest       Boolean @default(true) // Only one version per group should be true

  // Basics
  name         String?
  description  String?

  // Optional links to generated image files under this Study
  photoFileId  String? @unique
  coverFileId  String? @unique
  photoFile    File?   @relation("PersonaPhoto", fields: [photoFileId], references: [id])
  coverFile    File?   @relation("PersonaCover", fields: [coverFileId], references: [id])

  // Flexible structured payload (demographics, psychographics, behaviors, firmographics, goals, quotes, extra, image keys, etc.)
  data         Json?

  study        Study   @relation(fields: [studyId], references: [id], onDelete: Cascade)
  // Back relation: heuristic evaluations that reference this persona GROUP (not specific version)
  heuristicEvaluations HeuristicEvaluation[]
  // Back relation: cognitive walkthroughs that reference this persona GROUP (not specific version)
  cognitiveWalkthroughs CognitiveWalkthrough[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([studyId])
  @@index([photoFileId])
  @@index([coverFileId])
  @@index([personaGroupId])
  @@index([personaGroupId, version])
  @@index([personaGroupId, isLatest])
  @@unique([personaGroupId, version])
}

model CommunicationPreferences {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional (user can toggle)
  digest         Boolean  @default(true)
  productUpdates Boolean  @default(true)
  promotions     Boolean  @default(true)
  educational    Boolean  @default(true)
  feedback       Boolean  @default(true)

  // Required (always true; enforce in app/API layer)
  security       Boolean  @default(true)
  billing        Boolean  @default(true)
  policy         Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Notification {
  id          String               @id @default(cuid())
  userId      String
  type        NotificationType
  audience    NotificationAudience @default(USER)
  title       String
  message     String?
  actionUrl   String?
  isRead      Boolean              @default(false)
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime             @default(now())
  expiresAt   DateTime?

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([userId, audience])
}

model OtpCode {
  id         String   @id @default(cuid())
  email      String
  hashedCode String
  salt       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
  @@index([consumedAt])
}

enum StudyVisibility {
  PRIVATE   // Only the creator can view
  TEAM      // Team members can view (default)
  COMPANY   // All company members can view
}

enum StudyType {
  HEURISTIC_EVALUATION
  COGNITIVE_WALKTHROUGH
  PERSONA
  UNKNOWN
}

enum FileType {
  IMAGE
  DOCUMENT
  VIDEO
  AUDIO
  UNKNOWN
}

enum CWIssueType {
  DISCOVERABILITY
  LEARNABILITY
  USABILITY
  OTHER
}

enum CWQuestionType {
  QUESTION_1
  QUESTION_2
  QUESTION_3
  UNKNOWN
}

enum ImageType {
  APNG
  AVIF
  GIF
  JPEG
  PNG
  SVG
  WEBP
  UNKNOWN
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SourceType {
  AI
  HUMAN
  AI_HUMAN
  UNKNOWN
}

enum ContentRating {
  UP
  DOWN
}

enum StudyStatus {
  COMPLETED
  FAILED
  PENDING
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TeamJoinPolicy {
  INVITE_ONLY
  SECRET
  REQUEST_TO_JOIN
  SELF_JOIN
  AUTO_JOIN
}

// Company-level roles are separate from team roles
enum CompanyRole {
  OWNER
  ADMIN
  BILLING
  MEMBER
  VIEWER
}

// A claim to create or associate a company with a domain must be reviewed
enum ApprovalStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
  ERASED
}

enum CompanyMembershipStatus {
  PENDING
  ACTIVE
