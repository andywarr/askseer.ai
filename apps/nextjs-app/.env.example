# Application Environment
NODE_ENV=development

# Database Configuration
# AUTH_TRUST_HOST should match the domain Next.js runs on (e.g. http://localhost:3000 in dev)
AUTH_TRUST_HOST=http://localhost:3000
DATABASE_URL=postgresql://postgres@localhost:5432/askseer
NEXTAUTH_URL=http://localhost:3000

# Google OAuth Configuration
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# NextAuth Secret (Generate with `openssl rand -base64 32`)
AUTH_SECRET=your-nextauth-secret-key

# Resend Email Configuration
AUTH_RESEND_KEY=re_your_resend_api_key
AUTH_RESEND_FROM="Seer <notifications@mail.yourdomain.com>"

# AWS Configuration (S3 and SQS queue for processing tasks)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=askseer-dev
AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/your-account-id/askseer-dev

# CloudWatch Logging
LOG_GROUP_NAME=seer-web
LOG_STREAM_NAME=your-stream-name

# External Services
AI_WORKER_URL=http://localhost:3002
DB_WORKER_URL=http://localhost:3001
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
OPENAI_API_KEY=sk-proj-your-openai-api-key
INTERVIEW_REALTIME_MODEL=gpt-realtime-2

# Figma integration
FIGMA_CLIENT_ID=your-figma-client-id
FIGMA_CLIENT_SECRET=your-figma-client-secret
FIGMA_REDIRECT_URI=http://localhost:3000/api/figma/callback 
FIGMA_PLUGIN_API_KEY=your-figma-plugin-api-key

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-your-measurement-id

# LiveKit (Real-time interviews)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-subdomain.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Stripe payments
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
CREDIT_PRICE_FROM_ENV=19.99

# Cron Secret for securing cron API routes
CRON_SECRET=your-cron-secret-token
