{
  "name": "ai-worker",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "dev": "tsx watch src/server.ts",
    "dev:build": "node build.js && node ./build/server.cjs",
    "start": "node ./build/server.cjs",
    "clean": "rm -rf build",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3",
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/client-sqs": "^3",
    "@aws-sdk/s3-request-presigner": "^3",
    "@types/pino": "^7",
    "dotenv": "^16",
    "openai": "^5",
    "pino": "^9",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0",
    "esbuild-node-externals": "^1",
    "tsx": "^4",
    "typescript": "^5"
  },
  "type": "module"
}
