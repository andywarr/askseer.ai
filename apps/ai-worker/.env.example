# Application Environment
NODE_ENV=development

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1

# CloudWatch Logging
LOG_GROUP_NAME=seer-ai
LOG_STREAM_NAME=your-stream-name

# AWS S3 and SQS Configuration
AWS_BUCKET_NAME=askseer-dev
AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/your-account-id/askseer-dev

# External Services
DB_WORKER_URL=http://localhost:3001
OPENAI_API_KEY=sk-proj-your-openai-api-key

# Evaluation Configuration
HE_EVAL_MODE=batch
HE_EVAL_CONCURRENCY=10
HE_EVAL_BATCH_SIZE=20
HE_EVAL_MODEL=gpt-5-mini-2025-08-07
HE_EVAL_MAX_TOKENS=3000
HE_MAX_ATTEMPTS=3

# Deduplication Configuration
DEDUPE_MODEL=gpt-5.2-2025-12-11

# Walkthrough Configuration
CW_MODEL=gpt-5-mini-2025-08-07
CW_MAX_TOKENS=3000
CW_MAX_ATTEMPTS=3

# Persona Configuration
PERSONA_MODEL=gpt-5.2-2025-12-11
