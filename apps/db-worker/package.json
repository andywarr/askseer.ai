{
  "name": "db-worker",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "dev": "tsx watch src/server.ts",
    "dev:build": "node build.js && node ./build/server.cjs",
    "start": "node ./build/server.cjs",
    "clean": "rm -rf build",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "script:backfill-teams": "tsx scripts/backfill-teams.ts",
    "script:migrate-S3-teams": "tsx scripts/migrate-S3-teams.ts",
    "script:migrate-user-credits-to-team": "tsx scripts/migrate-user-credits-to-team.ts",
    "script:update-study-team": "tsx scripts/migrate-study-to-team.ts",
    "script:migrate-heuristics": "tsx scripts/migrate-heuristics-to-families.ts",
    "script:migrate-company-teams": "tsx scripts/migrate-company-teams.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3",
    "@aws-sdk/client-s3": "^3",
    "@prisma/client": "^6.15.0",
    "@types/pino": "^7",
    "cors": "^2",
    "dotenv": "^16",
    "express": "^4",
    "pino": "^9"
  },
  "devDependencies": {
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.0.14",
    "esbuild": "^0",
    "prisma": "^6.15.0",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.0.14"
  },
  "type": "module"
}
